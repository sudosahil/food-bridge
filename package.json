    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "multer": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
